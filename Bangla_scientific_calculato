    <script>
        // বাংলা ও ইংরেজি সংখ্যার ম্যাপিং
        const bnToEnDigits = { '০': '0', '১': '1', '২': '2', '৩': '3', '৪': '4', '৫': '5', '৬': '6', '৭': '7', '৮': '8', '৯': '9' };
        const enToBnDigits = { '0': '০', '1': '১', '2': '২', '3': '৩', '4': '৪', '5': '৫', '6': '৬', '7': '৭', '8': '৮', '9': '৯' }; 

        function toEnglishNumber(str) {
            return str.toString().replace(/[০-৯]/g, d => bnToEnDigits[d]);
        } 

        function toBanglaNumber(str) {
            return str.toString().replace(/[0-9]/g, d => enToBnDigits[d]);
        } 

        // ক্যালকুলেটর স্টেট
        let currentOperand = '0';
        let previousOperand = '';
        let operation = undefined;
        let shouldResetScreen = false;
        let soundEnabled = localStorage.getItem('bn_calc_sound') !== 'false';
        let history = [];
        try {
            history = JSON.parse(localStorage.getItem('bn_calc_history')) || [];
        } catch (e) {
            history = [];
        } 

        // DOM এলিমেন্ট
        const currentOperandEl = document.getElementById('current-operand');
        const previousOperandEl = document.getElementById('previous-operand');
        const inWordsEl = document.getElementById('in-words');
        const historyPanel = document.getElementById('history-panel');
        const historyList = document.getElementById('history-list');
        const historyBadge = document.getElementById('history-badge');
        const vatPanel = document.getElementById('vat-panel');
        const sciBar = document.getElementById('sci-bar');
        const sciToggleBtn = document.getElementById('sci-toggle-btn');
        const soundBtn = document.getElementById('sound-btn');
        const soundOnIcon = document.getElementById('sound-on-icon');
        const soundOffIcon = document.getElementById('sound-off-icon'); 

        // সাউন্ড ইফেক্ট (Lazy initialization)
        let audioCtx = null;
        function updateSoundUI() {
            soundBtn.classList.toggle('active', soundEnabled);
            soundOnIcon.classList.toggle('hidden', !soundEnabled);
            soundOffIcon.classList.toggle('hidden', soundEnabled);
        } 

        function toggleSound() {
            soundEnabled = !soundEnabled;
            localStorage.setItem('bn_calc_sound', soundEnabled);
            updateSoundUI();
            if (soundEnabled) playClickSound();
        } 

        function playClickSound() {
            if (!soundEnabled) return;
            try {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (!AudioContextClass) return;
                    audioCtx = new AudioContextClass();
                }
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(520, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(120, audioCtx.currentTime + 0.03);
                gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.03);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.03);
            } catch (e) {}
        } 

        // সায়েন্টিফিক বার টগল
        function toggleSciBar() {
            playClickSound();
            sciBar.classList.toggle('hidden');
            sciToggleBtn.classList.toggle('active', !sciBar.classList.contains('hidden'));
        } 

        // সংখ্যা ইনপুট
        function appendNumber(bnNumber) {
            playClickSound();
            const number = toEnglishNumber(bnNumber);
            if (shouldResetScreen) {
                currentOperand = number === '.' ? '0' : '';
                shouldResetScreen = false;
            }
            if (currentOperand === '0' && number !== '.') {
                currentOperand = '';
            }
            if (number === '.' && currentOperand.includes('.')) return;
            if (currentOperand.replace('-', '').length >= 15) return; 

            currentOperand = currentOperand.toString() + number.toString();
            updateDisplay();
        } 

        // চিহ্ন পরিবর্তন (±)
        function toggleSign() {
            playClickSound();
            if (currentOperand === '' || currentOperand === '0' || currentOperand === '0.') return;
            if (currentOperand.startsWith('-')) {
                currentOperand = currentOperand.slice(1);
            } else {
    
